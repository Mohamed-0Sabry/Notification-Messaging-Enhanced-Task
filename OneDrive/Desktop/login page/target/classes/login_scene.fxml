<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.login.LoginController"
      prefHeight="600.0" prefWidth="1000.0" style="-fx-background-color: #fcd3e1; -fx-background-radius: 20; -fx-padding: 20;">
    <!-- Illustration Side with background image -->
    <StackPane HBox.hgrow="ALWAYS" style="-fx-background-image: url('movie-night-background.png'); -fx-background-size: cover; -fx-background-position: center; -fx-background-radius: 20 0 0 20;">
        <ImageView fx:id="illustrationImage" fitWidth="440" fitHeight="560" pickOnBounds="true" preserveRatio="true"
                   style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 20, 0, 0, 0);"
                   StackPane.alignment="CENTER_LEFT" />
    </StackPane>

    <!-- Form Card Side -->
    <AnchorPane HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 20, 0, 0, 0);">
        <VBox alignment="TOP_CENTER" spacing="20" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" style="-fx-padding: 40 40 40 40;">
            <Label text="Welcome Back!" style="-fx-font-size: 48px; -fx-font-family: 'Comic Sans MS', 'Arial Black', cursive; -fx-font-weight: bold; -fx-text-fill: #fcd3e1;" />
            <Label text="Please log in to your account" style="-fx-font-size: 16px; -fx-font-family: 'Arial'; -fx-text-fill: #222; -fx-padding: 0 0 10 0;" />

            <!-- Email Field -->
            <VBox spacing="5" alignment="TOP_LEFT" style="-fx-pref-width: 100%;">
                <Label text="Email Address" style="-fx-font-size: 13px; -fx-font-family: 'Arial'; -fx-text-fill: #222;" />
                <TextField fx:id="loginEmail" promptText="" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-background-color: #f5f7fa; -fx-border-color: transparent; -fx-padding: 12; -fx-font-size: 15px;" />
            </VBox>

            <!-- Password Field with Toggle -->
            <VBox spacing="5" alignment="TOP_LEFT" style="-fx-pref-width: 100%;">
                <Label text="Password" style="-fx-font-size: 13px; -fx-font-family: 'Arial'; -fx-text-fill: #222;" />
                <HBox alignment="CENTER_LEFT" spacing="0">
                    <PasswordField fx:id="loginPassword" promptText="" style="-fx-background-radius: 10 0 0 10; -fx-border-radius: 10 0 0 10; -fx-background-color: #f5f7fa; -fx-border-color: transparent; -fx-padding: 12; -fx-font-size: 15px;" HBox.hgrow="ALWAYS" />
                    <Button fx:id="togglePasswordBtn" onAction="#togglePasswordVisibility" style="-fx-background-color: #f5f7fa; -fx-background-radius: 0 10 10 0; -fx-border-radius: 0 10 10 0; -fx-border-color: transparent; -fx-padding: 0 16 0 16;">
                        <Label fx:id="togglePasswordIcon" text="👁" style="-fx-font-size: 18px; -fx-text-fill: #888;" />
                    </Button>
                </HBox>
            </VBox>

            <!-- Sign Up Button -->
            <Button text="Sign Up" style="-fx-background-color: #fcd3e1; -fx-text-fill: white; -fx-font-size: 28px; -fx-font-family: 'Comic Sans MS', 'Arial Black', cursive; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 0 12 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0, 0, 0);" maxWidth="Infinity" />

            <!-- Forgot Password -->
            <VBox spacing="2" alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
                <Label text="Forgot your password?" style="-fx-font-size: 14px; -fx-font-family: 'Arial'; -fx-font-weight: bold; -fx-text-fill: #222;" />
                <Hyperlink text="www.reallygreatsite.com" style="-fx-font-size: 13px; -fx-text-fill: #fcd3e1; -fx-underline: false;" />
            </VBox>
        </VBox>
    </AnchorPane>
</HBox>
